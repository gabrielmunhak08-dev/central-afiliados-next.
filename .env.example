# Copie este arquivo para .env e preencha apenas no seu dispositivo.
# Nunca coloque credenciais reais neste arquivo de exemplo.
SHOPEE_APP_ID=COLOQUE_SEU_APP_ID
SHOPEE_APP_SECRET=COLOQUE_SEU_APP_SECRET
# Opcional para a Central, caso ainda não esteja definido no ambiente:
# CENTRAL_SECRET_KEY=gere-uma-chave-forte-localmente
